<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Preferences">
        <ListPreference
            app:key="theme_mode"
            app:title="Theme"
            app:summary="Choose the app appearance"
            app:defaultValue="system"
            app:entries="@array/theme_mode_entries"
            app:entryValues="@array/theme_mode_values"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="notifications"
            app:title="Notifications"
            app:summary="Receive app notifications" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Version">
        <Preference
            app:key="pref_about"
            app:title="About Student Locker"
            app:summary="Version 1.0" />
    </PreferenceCategory>

</PreferenceScreen>
